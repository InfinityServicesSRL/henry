<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Tablero. Seis preguntas, seis acciones, dos vistas.

    No hay pantalla de mosaico ni componente propio: son el gráfico y el
    pivote nativos de Odoo. La razón no es pereza. Un gráfico nativo es
    navegable: al hacer clic en una barra o en una celda, Odoo abre la lista
    de los registros que están detrás, y de la lista se entra a la ficha del
    cliente. Un mosaico dibujado a mano pierde eso y hay que reconstruirlo.

    Por eso cada acción declara `view_mode` con la vista de datos PRIMERO y
    `list,form` después: ese orden es el que hace posible bajar del número al
    expediente. Quitar `list` o `form` de ahí rompe el clic.

    Las vistas de gráfico y pivote no fijan agrupación: la fija cada acción
    por contexto. Así seis preguntas distintas viven sobre dos vistas y no
    sobre doce.
  -->

  <record id="view_partner_graph_desempeno" model="ir.ui.view">
    <field name="name">res.partner.graph.desempeno</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <graph string="Desempeño" type="bar" sample="1">
        <field name="ag_desemp_grado"/>
        <field name="ag_venta_12m" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="view_partner_pivot_desempeno" model="ir.ui.view">
    <field name="name">res.partner.pivot.desempeno</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <pivot string="Desempeño" sample="1">
        <field name="ag_desemp_grado" type="row"/>
        <field name="ag_venta_12m" type="measure"/>
        <field name="ag_cxc_vencido" type="measure"/>
      </pivot>
    </field>
  </record>

  <!--
    Ficha de un corte mensual. Existe para cerrar el recorrido: desde la
    curva de evolución se llega al mes, y del mes al cliente. Sin ella el
    clic muere en una fila de tabla.
  -->
  <record id="view_ag_snapshot_form" model="ir.ui.view">
    <field name="name">ag.desempeno.snapshot.form</field>
    <field name="model">ag.desempeno.snapshot</field>
    <field name="arch" type="xml">
      <form string="Corte mensual" create="false" edit="false">
        <sheet>
          <div class="oe_title">
            <h1><field name="periodo" readonly="1"/></h1>
            <h2><field name="partner_id" readonly="1" options="{'no_open': False}"/></h2>
          </div>
          <group>
            <group string="El mes">
              <field name="venta_neta" readonly="1"/>
              <field name="margen_monto" readonly="1"/>
              <field name="margen_pct" readonly="1"/>
              <field name="facturas" readonly="1"/>
              <field name="devoluciones" readonly="1"/>
            </group>
            <group string="Acumulado y estado">
              <field name="venta_12m" readonly="1"/>
              <field name="margen_pct_12m" readonly="1"/>
              <field name="score" readonly="1"/>
              <field name="grado" readonly="1"/>
              <field name="tendencia" readonly="1"/>
            </group>
            <group string="Cobranza al corte">
              <field name="cxc_total" readonly="1"/>
              <field name="cxc_vencido" readonly="1"/>
              <field name="dias_cobro" readonly="1"/>
            </group>
            <group string="Contexto">
              <field name="segmento" readonly="1"/>
              <field name="user_id" readonly="1"/>
              <field name="fecha_corte" readonly="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <div class="text-muted">
            El nombre del cliente abre su expediente completo, con el desempeño
            de hoy — no el de este corte.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ================================================================
       01 · Dónde está la facturación
       ================================================================ -->
  <record id="action_tablero_grado" model="ir.actions.act_window">
    <field name="name">Distribución por grado</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">graph,pivot,list,form</field>
    <field name="domain">[('customer_rank','&gt;',0),('parent_id','=',False)]</field>
    <field name="search_view_id" ref="view_partner_search_desempeno"/>
    <field name="context">{
      'graph_mode': 'bar',
      'graph_groupbys': ['ag_desemp_grado'],
      'graph_measure': 'ag_venta_12m',
      'graph_order': 'DESC',
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Todavía no hay clientes evaluados</p>
      <p>Corra <b>Recalcular desempeño</b> desde Configuración, o espere al
         proceso nocturno.</p>
    </field>
  </record>

  <record id="action_tablero_grado_graph" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">graph</field>
    <field name="view_id" ref="view_partner_graph_desempeno"/>
    <field name="act_window_id" ref="action_tablero_grado"/>
  </record>
  <record id="action_tablero_grado_pivot" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_partner_pivot_desempeno"/>
    <field name="act_window_id" ref="action_tablero_grado"/>
  </record>
  <record id="action_tablero_grado_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_desempeno"/>
    <field name="act_window_id" ref="action_tablero_grado"/>
  </record>

  <!-- ================================================================
       02 · Grado × tendencia
       ================================================================ -->
  <record id="action_tablero_riesgo" model="ir.actions.act_window">
    <field name="name">Grado × tendencia</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">pivot,graph,list,form</field>
    <field name="domain">[('customer_rank','&gt;',0),('parent_id','=',False)]</field>
    <field name="search_view_id" ref="view_partner_search_desempeno"/>
    <field name="context">{
      'pivot_row_groupby': ['ag_desemp_grado'],
      'pivot_column_groupby': ['ag_desemp_tendencia'],
      'pivot_measures': ['__count', 'ag_venta_12m'],
    }</field>
  </record>

  <record id="action_tablero_riesgo_pivot" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_partner_pivot_desempeno"/>
    <field name="act_window_id" ref="action_tablero_riesgo"/>
  </record>
  <record id="action_tablero_riesgo_graph" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">graph</field>
    <field name="view_id" ref="view_partner_graph_desempeno"/>
    <field name="act_window_id" ref="action_tablero_riesgo"/>
  </record>
  <record id="action_tablero_riesgo_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_desempeno"/>
    <field name="act_window_id" ref="action_tablero_riesgo"/>
  </record>

  <!-- ================================================================
       03 · Evolución de la cartera
       ================================================================ -->
  <record id="action_tablero_evolucion" model="ir.actions.act_window">
    <field name="name">Evolución de la cartera</field>
    <field name="res_model">ag.desempeno.snapshot</field>
    <field name="view_mode">graph,pivot,list,form</field>
    <field name="context">{
      'graph_mode': 'line',
      'graph_groupbys': ['periodo'],
      'graph_measure': 'venta_neta',
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Todavía no hay cortes guardados</p>
      <p>El histórico se arma solo: el proceso nocturno guarda un corte por mes.
         Con un solo corte la curva es un punto.</p>
    </field>
  </record>

  <!-- ================================================================
       04 · Facturación por vendedor
       ================================================================ -->
  <record id="action_tablero_vendedor" model="ir.actions.act_window">
    <field name="name">Facturación por vendedor</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">graph,pivot,list,form</field>
    <field name="domain">[('customer_rank','&gt;',0),('parent_id','=',False)]</field>
    <field name="search_view_id" ref="view_partner_search_desempeno"/>
    <field name="context">{
      'graph_mode': 'bar',
      'graph_groupbys': ['user_id'],
      'graph_measure': 'ag_venta_12m',
      'graph_order': 'DESC',
    }</field>
  </record>

  <record id="action_tablero_vendedor_graph" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">graph</field>
    <field name="view_id" ref="view_partner_graph_desempeno"/>
    <field name="act_window_id" ref="action_tablero_vendedor"/>
  </record>
  <record id="action_tablero_vendedor_pivot" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_partner_pivot_desempeno"/>
    <field name="act_window_id" ref="action_tablero_vendedor"/>
  </record>
  <record id="action_tablero_vendedor_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_desempeno"/>
    <field name="act_window_id" ref="action_tablero_vendedor"/>
  </record>

  <!-- ================================================================
       05 · Evolución por vendedor
       ================================================================ -->
  <record id="action_tablero_vendedor_mes" model="ir.actions.act_window">
    <field name="name">Evolución por vendedor</field>
    <field name="res_model">ag.desempeno.snapshot</field>
    <field name="view_mode">graph,pivot,list,form</field>
    <field name="context">{
      'graph_mode': 'line',
      'graph_groupbys': ['periodo', 'user_id'],
      'graph_measure': 'venta_neta',
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Todavía no hay cortes guardados</p>
      <p>Cada mes que pasa agrega un punto a cada curva.</p>
    </field>
  </record>

  <!-- ================================================================
       06 · Cartera del vendedor
       ================================================================ -->
  <record id="action_tablero_cartera_vendedor" model="ir.actions.act_window">
    <field name="name">Cartera del vendedor</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">pivot,graph,list,form</field>
    <field name="domain">[('customer_rank','&gt;',0),('parent_id','=',False)]</field>
    <field name="search_view_id" ref="view_partner_search_desempeno"/>
    <field name="context">{
      'pivot_row_groupby': ['user_id'],
      'pivot_column_groupby': ['ag_desemp_grado'],
      'pivot_measures': ['__count', 'ag_venta_12m', 'ag_cxc_vencido'],
    }</field>
  </record>

  <record id="action_tablero_cartera_pivot" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_partner_pivot_desempeno"/>
    <field name="act_window_id" ref="action_tablero_cartera_vendedor"/>
  </record>
  <record id="action_tablero_cartera_graph" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">graph</field>
    <field name="view_id" ref="view_partner_graph_desempeno"/>
    <field name="act_window_id" ref="action_tablero_cartera_vendedor"/>
  </record>
  <record id="action_tablero_cartera_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_desempeno"/>
    <field name="act_window_id" ref="action_tablero_cartera_vendedor"/>
  </record>

  <!-- ================================================================
       07 · Contactabilidad — el hueco que frena el envío
       ================================================================ -->
  <record id="action_tablero_contacto" model="ir.actions.act_window">
    <field name="name">Clientes sin contacto</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">pivot,graph,list,form</field>
    <field name="domain">[('customer_rank','&gt;',0),('parent_id','=',False),('ag_sin_contacto','=',True)]</field>
    <field name="search_view_id" ref="view_partner_search_desempeno"/>
    <field name="context">{
      'pivot_row_groupby': ['user_id'],
      'pivot_column_groupby': ['ag_recencia'],
      'pivot_measures': ['__count', 'ag_venta_12m'],
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Todos los clientes tienen por dónde recibir</p>
      <p>Aquí caen los que no tienen correo, WhatsApp ni teléfono. Mientras
         estén en esta lista, no reciben estado de cuenta ni ficha técnica.</p>
    </field>
  </record>

  <record id="action_tablero_contacto_pivot" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">pivot</field>
    <field name="view_id" ref="view_partner_pivot_desempeno"/>
    <field name="act_window_id" ref="action_tablero_contacto"/>
  </record>
  <record id="action_tablero_contacto_graph" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">graph</field>
    <field name="view_id" ref="view_partner_graph_desempeno"/>
    <field name="act_window_id" ref="action_tablero_contacto"/>
  </record>
  <record id="action_tablero_contacto_list" model="ir.actions.act_window.view">
    <field name="sequence" eval="3"/>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_partner_list_desempeno"/>
    <field name="act_window_id" ref="action_tablero_contacto"/>
  </record>

</odoo>
