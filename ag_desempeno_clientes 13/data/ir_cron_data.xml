<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Recálculo nocturno. Las métricas son pesadas (doce meses de
      facturación, conciliación y despacho para toda la cartera): corren de
      madrugada, no cuando alguien abre la vista de contactos.
    -->
    <record id="cron_recalcular_desempeno" model="ir.cron">
      <field name="name">Desempeño: recalcular cartera</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="state">code</field>
      <field name="code">model._cron_recalcular_desempeno()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
      <field name="nextcall"
             eval="(DateTime.now().replace(hour=6, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!--
      Cierre mensual: congela la foto del mes que terminó. Corre el día 1
      para que el mes anterior ya no reciba más asientos.
    -->
    <record id="cron_cerrar_mes" model="ir.cron">
      <field name="name">Desempeño: cerrar mes</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="state">code</field>
      <field name="code">model._cron_cerrar_mes()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">months</field>
      <field name="active" eval="True"/>
      <field name="nextcall"
             eval="(DateTime.now().replace(day=1, hour=8, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

  </data>
</odoo>
