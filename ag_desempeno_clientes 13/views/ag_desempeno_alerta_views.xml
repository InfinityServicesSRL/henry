<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_ag_alerta_list" model="ir.ui.view">
    <field name="name">ag.desempeno.alerta.list</field>
    <field name="model">ag.desempeno.alerta</field>
    <field name="arch" type="xml">
      <list string="Alertas" create="false"
            decoration-danger="severidad == 'crit' and not atendida"
            decoration-warning="severidad == 'warn' and not atendida"
            decoration-muted="atendida or not activa">
        <field name="fecha"/>
        <field name="partner_id"/>
        <field name="user_id" optional="show"/>
        <field name="tipo"/>
        <field name="titulo"/>
        <field name="detalle" optional="show"/>
        <field name="severidad"/>
        <field name="atendida" widget="boolean_toggle"/>
        <field name="activa" optional="hide"/>
        <button name="action_marcar_atendida" type="object" string="Atendida"
                icon="fa-check" class="btn-link" invisible="atendida"/>
        <button name="action_reabrir" type="object" string="Reabrir"
                icon="fa-undo" class="btn-link" invisible="not atendida"/>
      </list>
    </field>
  </record>

  <record id="view_ag_alerta_form" model="ir.ui.view">
    <field name="name">ag.desempeno.alerta.form</field>
    <field name="model">ag.desempeno.alerta</field>
    <field name="arch" type="xml">
      <form string="Alerta">
        <header>
          <button name="action_marcar_atendida" type="object"
                  string="Marcar atendida" class="btn-primary" invisible="atendida"/>
          <button name="action_reabrir" type="object"
                  string="Reabrir" class="btn-secondary" invisible="not atendida"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="titulo" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="partner_id" readonly="1"/>
              <field name="user_id" readonly="1"/>
              <field name="tipo" readonly="1"/>
              <field name="severidad" readonly="1"/>
            </group>
            <group>
              <field name="fecha" readonly="1"/>
              <field name="valor" readonly="1"/>
              <field name="activa" readonly="1"/>
              <field name="atendida_por" readonly="1"/>
              <field name="atendida_el" readonly="1"/>
            </group>
          </group>
          <separator string="Detalle"/>
          <field name="detalle" readonly="1"/>
          <separator string="Nota de seguimiento"/>
          <field name="nota_seguimiento"
                 placeholder="Qué se hizo, con quién se habló, qué se acordó…"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_ag_alerta_search" model="ir.ui.view">
    <field name="name">ag.desempeno.alerta.search</field>
    <field name="model">ag.desempeno.alerta</field>
    <field name="arch" type="xml">
      <search string="Alertas">
        <field name="partner_id"/>
        <field name="titulo"/>
        <field name="user_id"/>
        <filter name="pendientes" string="Pendientes"
                domain="[('atendida','=',False),('activa','=',True)]"/>
        <filter name="criticas" string="Actuar"
                domain="[('severidad','=','crit'),('atendida','=',False),('activa','=',True)]"/>
        <filter name="mias" string="De mis clientes" domain="[('user_id','=',uid)]"/>
        <separator/>
        <filter name="archivadas" string="Resueltas por el sistema"
                domain="[('activa','=',False)]"/>
        <group expand="0" string="Agrupar por">
          <filter name="g_tipo" string="Tipo" context="{'group_by':'tipo'}"/>
          <filter name="g_sev" string="Severidad" context="{'group_by':'severidad'}"/>
          <filter name="g_vendedor" string="Vendedor" context="{'group_by':'user_id'}"/>
          <filter name="g_cliente" string="Cliente" context="{'group_by':'partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_ag_alertas" model="ir.actions.act_window">
    <field name="name">Alertas</field>
    <field name="res_model">ag.desempeno.alerta</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_pendientes': 1, 'search_default_g_sev': 1}</field>
    <field name="search_view_id" ref="view_ag_alerta_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Ninguna alerta pendiente</p>
      <p>Las alertas aparecen solas cuando un cliente cruza uno de los
         umbrales configurados.</p>
    </field>
  </record>

</odoo>
