<?xml version="1.0" encoding="utf-8"?>
<!--
    Tipos de Work Entry dominicanos — AG Supply
    Registran qué hizo el empleado cada día para generar el recibo correctamente.
-->
<odoo>
    <data noupdate="1">

        <!-- Asistencia regular — 100% del salario -->
        <record id="work_entry_asistencia" model="hr.work.entry.type">
            <field name="name">Asistencia regular</field>
            <field name="code">WORK100</field>
            <field name="color">10</field><!-- verde -->
            <field name="time_type">work</field>
            <field name="is_leave">False</field>
        </record>

        <!-- Vacaciones pagadas (14 días primer año, 18 días 5+ años) -->
        <record id="work_entry_vacaciones" model="hr.work.entry.type">
            <field name="name">Vacaciones</field>
            <field name="code">LEAVE100</field>
            <field name="color">4</field><!-- azul -->
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

        <!-- Licencia médica — TSS paga desde el 4to día, empresa paga primeros 3 -->
        <record id="work_entry_licencia_medica" model="hr.work.entry.type">
            <field name="name">Licencia médica (subsidio TSS)</field>
            <field name="code">SICK_TSS</field>
            <field name="color">2</field><!-- amarillo -->
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

        <!-- Ausencia injustificada — no genera pago, puede generar descuento -->
        <record id="work_entry_ausencia" model="hr.work.entry.type">
            <field name="name">Ausencia injustificada</field>
            <field name="code">LEAVE_UNPAID</field>
            <field name="color">1</field><!-- rojo -->
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

        <!-- Horas extra días laborables — 35% adicional -->
        <record id="work_entry_he35" model="hr.work.entry.type">
            <field name="name">Hora extra 35% (día laborable)</field>
            <field name="code">HE35</field>
            <field name="color">6</field><!-- naranja -->
            <field name="time_type">work</field>
            <field name="is_leave">False</field>
        </record>

        <!-- Horas extra feriados/descanso — 100% adicional -->
        <record id="work_entry_he100" model="hr.work.entry.type">
            <field name="name">Hora extra 100% (feriado/descanso semanal)</field>
            <field name="code">HE100</field>
            <field name="color">1</field><!-- rojo -->
            <field name="time_type">work</field>
            <field name="is_leave">False</field>
        </record>

        <!-- Feriado nacional NO trabajado (pago normal, sin asistir) -->
        <record id="work_entry_feriado" model="hr.work.entry.type">
            <field name="name">Feriado nacional</field>
            <field name="code">HOLIDAY</field>
            <field name="color">5</field><!-- morado -->
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

        <!-- Hora nocturna 9pm–7am — 15% adicional sobre hora ordinaria -->
        <record id="work_entry_nocturna" model="hr.work.entry.type">
            <field name="name">Hora nocturna (9pm–7am)</field>
            <field name="code">HNOC</field>
            <field name="color">0</field><!-- gris -->
            <field name="time_type">work</field>
            <field name="is_leave">False</field>
        </record>

        <!-- Maternidad (84 días — Ley 87-01 Art. 59) -->
        <record id="work_entry_maternidad" model="hr.work.entry.type">
            <field name="name">Licencia de maternidad (84 días)</field>
            <field name="code">MATERNIDAD</field>
            <field name="color">9</field><!-- rosa -->
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

        <!-- Paternidad (2 días — Ley 87-01) -->
        <record id="work_entry_paternidad" model="hr.work.entry.type">
            <field name="name">Licencia de paternidad (2 días)</field>
            <field name="code">PATERNIDAD</field>
            <field name="color">4</field>
            <field name="time_type">leave</field>
            <field name="is_leave">True</field>
        </record>

    </data>
</odoo>
