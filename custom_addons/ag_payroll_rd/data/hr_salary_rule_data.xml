<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas salariales — AG Supply, SRL. — Odoo 18
    República Dominicana — Ley 87-01 (TSS), Código de Trabajo, DGII ISR 2026

    SECUENCIA DE EJECUCIÓN (sequence):
      10–90   Ingresos (contribuyen a GROSS)
      100–190 Deducciones empleado (requieren GROSS calculado; ISR requiere TSS calculado)
      200     Neto (NET = GROSS - DED)
      300–390 Contribuciones patronales (costo empresa, no afectan el neto del empleado)

    CONVENCIÓN:
      - Reglas de deducción usan amount_python que retorna valor POSITIVO;
        la categoría DED las convierte en negativas al calcular NET.
      - SRL: NO se descuenta al empleado (Art. 191 Ley 87-01 lo prohíbe expresamente).
      - El incentivo INCPROD y las comisiones SÍ cotizan TSS y SÍ son gravables ISR.
-->
<odoo>
    <data noupdate="0">

    <!-- ════════════════════════════════════════════════════════════════════
         ESTRUCTURA: NÓMINA QUINCENAL REGULAR
    ═══════════════════════════════════════════════════════════════════════ -->

        <!-- ── 1. SUELDO QUINCENAL ──────────────────────────────────────── -->
        <record id="rule_sueldo" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Sueldo quincenal</field>
            <field name="code">SUELDO</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Salario quincenal = salario mensual / 2
# El salario diario dominicano se calcula sobre 23.83 días/mes (art. 197 CT)
result = contract.wage / 2.0
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 2. HORAS EXTRA 35% (días laborables, jornada extendida) ─── -->
        <record id="rule_he35" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Horas extra 35%</field>
            <field name="code">HE35</field>
            <field name="sequence">20</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.HE35 and inputs.HE35.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Valor hora ordinaria = salario mensual / 23.83 días / 8 horas
hora_ordinaria = contract.wage / 23.83 / 8.0
# Hora extra 35%: 1.35 veces el valor hora ordinaria
result = inputs.HE35.amount * hora_ordinaria * 1.35
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 3. HORAS EXTRA 100% (feriados y día de descanso semanal) ── -->
        <record id="rule_he100" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Horas extra 100% (feriados/descanso)</field>
            <field name="code">HE100</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.HE100 and inputs.HE100.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
hora_ordinaria = contract.wage / 23.83 / 8.0
# Feriado o descanso semanal: 2.0 veces el valor hora ordinaria
result = inputs.HE100.amount * hora_ordinaria * 2.0
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 4. HORAS NOCTURNAS (9 pm – 7 am, +15%) ───────────────────── -->
        <record id="rule_hnoc" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Recargo horas nocturnas 15%</field>
            <field name="code">HNOC</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.HNOC and inputs.HNOC.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Solo el RECARGO 15% — la hora ordinaria ya está en SUELDO
hora_ordinaria = contract.wage / 23.83 / 8.0
result = inputs.HNOC.amount * hora_ordinaria * 0.15
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 5. INCENTIVO DE PRODUCCIÓN ────────────────────────────────── -->
        <record id="rule_incprod" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Incentivo de producción</field>
            <field name="code">INCPROD</field>
            <field name="sequence">35</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.INCPROD and inputs.INCPROD.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# El monto ya viene calculado desde el wizard ag.incentivo (unidades × tarifa por producto).
# Cargado como 'otra entrada' tipo INCPROD antes de confirmar el recibo.
# Cotiza TSS y es gravable ISR (no es regalía ni bonificación).
result = inputs.INCPROD.amount
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 6. COMISIÓN DE VENTAS ──────────────────────────────────────── -->
        <record id="rule_comision" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Comisión de ventas</field>
            <field name="code">COMISION</field>
            <field name="sequence">40</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.COMISION and inputs.COMISION.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Cargada manualmente por Solanyi/Henry cada quincena según ventas cobradas.
# Cotiza TSS (es salario regular Art. 194 CT) y es gravable ISR.
result = inputs.COMISION.amount
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 7. AUSENCIA INJUSTIFICADA (descuento de días) ─────────────── -->
        <record id="rule_ausencia" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Descuento ausencias injustificadas</field>
            <field name="code">AUSENCIA</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = bool(worked_days.LEAVE_UNPAID and worked_days.LEAVE_UNPAID.number_of_days > 0)
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Salario diario = salario mensual / 23.83 (días hábiles dominicanos)
salario_diario = contract.wage / 23.83
dias_ausentes = worked_days.LEAVE_UNPAID.number_of_days if worked_days.LEAVE_UNPAID else 0
result = salario_diario * dias_ausentes
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 8. SFS EMPLEADO (ARS — Seguro Familiar de Salud) ──────────── -->
        <record id="rule_sfs_emp" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">SFS — ARS empleado (3.04%)</field>
            <field name="code">SFS_EMP</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Base cotizable SFS: menor entre salario bruto quincenal y mitad del tope mensual
# Tope 2026: RD$ 232,230 mensual (10 salarios mínimos) → quincenal: 116,115
tope_sfs_mensual = payslip._rule_parameter('rd_tope_sfs')
tope_sfs_quincenal = tope_sfs_mensual / 2.0

# GROSS aquí incluye: SUELDO + HE35 + HE100 + HNOC + INCPROD + COMISION - AUSENCIA
bruto = categories.GROSS
base_cotizable = min(bruto, tope_sfs_quincenal)
tasa = payslip._rule_parameter('rd_sfs_emp')
result = base_cotizable * tasa
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 9. AFP EMPLEADO (Pensiones) ───────────────────────────────── -->
        <record id="rule_afp_emp" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">AFP — Pensiones empleado (2.87%)</field>
            <field name="code">AFP_EMP</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Tope AFP 2026: RD$ 464,460 mensual (20 SM) → quincenal: 232,230
tope_afp_mensual = payslip._rule_parameter('rd_tope_afp')
tope_afp_quincenal = tope_afp_mensual / 2.0

bruto = categories.GROSS
base_cotizable = min(bruto, tope_afp_quincenal)
tasa = payslip._rule_parameter('rd_afp_emp')
result = base_cotizable * tasa
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 10. ISR — RETENCIÓN (DGII, anualizado) ─────────────────────── -->
        <record id="rule_isr" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">ISR — Retención DGII</field>
            <field name="code">ISR</field>
            <field name="sequence">120</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Delega al método HrPayslip._get_rd_isr() que centraliza la lógica ISR.
# Ley 30-26: escala cambia automáticamente el 01-ene-2027 sin tocar este código.
# Los campos rd_base_isr_anual / rd_isr_anual / rd_isr_quincenal quedan
# guardados en el recibo para trazabilidad con Angélica / DGII.
sfs_quincena = rules.SFS_EMP.total if hasattr(rules, 'SFS_EMP') else 0.0
afp_quincena = rules.AFP_EMP.total if hasattr(rules, 'AFP_EMP') else 0.0
result = payslip._get_rd_isr(categories.GROSS, sfs_quincena, afp_quincena)
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 11. CUOTA PRÉSTAMO INTERNO ────────────────────────────────── -->
        <record id="rule_prestamo" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Cuota préstamo interno</field>
            <field name="code">PRESTAMO</field>
            <field name="sequence">130</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.PRESTAMO and inputs.PRESTAMO.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.PRESTAMO.amount</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 12. DESCUENTO COOPERATIVA ─────────────────────────────────── -->
        <record id="rule_coop" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Descuento cooperativa</field>
            <field name="code">COOP</field>
            <field name="sequence">140</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.COOP and inputs.COOP.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.COOP.amount</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 13. ANTICIPO DE QUINCENA ──────────────────────────────────── -->
        <record id="rule_anticipo" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Anticipo de quincena</field>
            <field name="code">ANTICIPO</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.ANTICIPO and inputs.ANTICIPO.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.ANTICIPO.amount</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 14. DESCUENTO UNIFORMES ───────────────────────────────────── -->
        <record id="rule_uniforme" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Descuento uniformes / EPP</field>
            <field name="code">UNIFORME</field>
            <field name="sequence">160</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.UNIFORME and inputs.UNIFORME.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.UNIFORME.amount</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 15. EMBARGO JUDICIAL ──────────────────────────────────────── -->
        <record id="rule_embargo" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Embargo judicial</field>
            <field name="code">EMBARGO</field>
            <field name="sequence">165</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.EMBARGO and inputs.EMBARGO.amount > 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.EMBARGO.amount</field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ── 16. NETO A PAGAR ───────────────────────────────────────────── -->
        <record id="rule_neto" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">NETO A PAGAR</field>
            <field name="code">NET</field>
            <field name="sequence">200</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# GROSS = suma de categoría ALW (ingresos)
# DED   = suma de categoría DED (deducciones, en negativo)
result = categories.GROSS + categories.DED
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <!-- ════════════════════════════════════════════════
             CONTRIBUCIONES PATRONALES (costo empresa)
             NO aparecen en el volante del empleado.
             Se usan para el asiento contable del costo laboral.
        ═══════════════════════════════════════════════════ -->

        <!-- ── 17. SFS PATRONAL (ARS) ─────────────────────────────────────── -->
        <record id="rule_sfs_pat" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">SFS — ARS patronal (7.09%)</field>
            <field name="code">SFS_PAT</field>
            <field name="sequence">300</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
tope_quincenal = payslip._rule_parameter('rd_tope_sfs') / 2.0
base_cotizable = min(categories.GROSS, tope_quincenal)
result = base_cotizable * payslip._rule_parameter('rd_sfs_pat')
            </field>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- ── 18. AFP PATRONAL (Pensiones) ──────────────────────────────── -->
        <record id="rule_afp_pat" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">AFP — Pensiones patronal (7.10%)</field>
            <field name="code">AFP_PAT</field>
            <field name="sequence">310</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
tope_quincenal = payslip._rule_parameter('rd_tope_afp') / 2.0
base_cotizable = min(categories.GROSS, tope_quincenal)
result = base_cotizable * payslip._rule_parameter('rd_afp_pat')
            </field>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- ── 19. FONDO DE SOLIDARIDAD SOCIAL (0.40%) ───────────────────── -->
        <record id="rule_fss" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">Fondo de Solidaridad Social (0.40%)</field>
            <field name="code">FSS</field>
            <field name="sequence">320</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Mismo tope que AFP (20 SM)
tope_quincenal = payslip._rule_parameter('rd_tope_afp') / 2.0
base_cotizable = min(categories.GROSS, tope_quincenal)
result = base_cotizable * payslip._rule_parameter('rd_fss')
            </field>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- ── 20. SRL/IDOPPRIL (Riesgos Laborales — solo patronal) ─────── -->
        <record id="rule_srl" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">SRL — Riesgos Laborales patronal (IDOPPRIL)</field>
            <field name="code">SRL</field>
            <field name="sequence">330</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# ⚠ CONFIRMAR clase de riesgo IDOPPRIL con Angélica
# Manufactura papel: provisional 1.30% (tope 4 SM = RD$ 92,892 mensual)
# Art. 191 Ley 87-01: PROHIBIDO descontar SRL al empleado
tope_quincenal = payslip._rule_parameter('rd_tope_srl') / 2.0
base_cotizable = min(categories.GROSS, tope_quincenal)
result = base_cotizable * payslip._rule_parameter('rd_srl')
            </field>
            <field name="appears_on_payslip">False</field>
        </record>

        <!-- ── 21. INFOTEP PATRONAL (1% nómina mensual — Ley 116-80) ─────── -->
        <record id="rule_infotep_pat" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_quincenal"/>
            <field name="name">INFOTEP patronal (1%)</field>
            <field name="code">INFOTEP_PAT</field>
            <field name="sequence">340</field>
            <field name="category_id" ref="hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# 1% de la nómina quincenal bruta. Sin tope.
result = categories.GROSS * payslip._rule_parameter('rd_infotep_pat')
            </field>
            <field name="appears_on_payslip">False</field>
        </record>


    <!-- ════════════════════════════════════════════════════════════════════
         ESTRUCTURA: REGALÍA PASCUAL
         - Exenta ISR hasta 1/12 del salario ordinario anual
         - NO cotiza TSS
         - INFOTEP empleado NO aplica (aplica solo sobre bonificación Art. 223)
    ═══════════════════════════════════════════════════════════════════════ -->

        <record id="rule_regalia_monto" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_regalia"/>
            <field name="name">Regalía pascual</field>
            <field name="code">REGALIA</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Regalía = 1/12 de salarios ordinarios devengados en el año
# Por simplicidad inicial: usamos salario mensual del contrato como base
# Para empleados con menos de 1 año: proporcional a los meses trabajados
# TODO: calcular desde nóminas reales del año (acumular SUELDO + HE + INCPROD del año)
result = contract.wage  # = 1/12 × 12 meses = 1 salario mensual (provisión exacta)
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="rule_regalia_isr" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_regalia"/>
            <field name="name">ISR sobre regalía (excedente exento)</field>
            <field name="code">ISR_REGALIA</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
# Solo retener ISR si la regalía supera 1/12 del salario ordinario anual
# Exención: 1 salario mensual (lo que calculamos como REGALIA base)
# El excedente es gravable. Para la mayoría de empleados de AG Supply: exento.
result = categories.GROSS > contract.wage
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
exento = contract.wage
excedente = categories.GROSS - exento
# Aplicar tasa marginal ISR del empleado sobre el excedente anualizado
base_anual = excedente * 12
exencion = payslip._rule_parameter('rd_isr_exencion')
t2_techo = payslip._rule_parameter('rd_isr_t2_techo')
t3_techo = payslip._rule_parameter('rd_isr_t3_techo')
t3_base  = payslip._rule_parameter('rd_isr_t3_base')
t4_base  = payslip._rule_parameter('rd_isr_t4_base')
if base_anual <= exencion:
    result = 0.0
elif base_anual <= t2_techo:
    result = (base_anual - exencion) * 0.15 / 12
elif base_anual <= t3_techo:
    result = (t3_base + (base_anual - t2_techo) * 0.20) / 12
else:
    result = (t4_base + (base_anual - t3_techo) * 0.25) / 12
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="rule_regalia_net" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_regalia"/>
            <field name="name">Neto regalía</field>
            <field name="code">NET</field>
            <field name="sequence">200</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.GROSS + categories.DED</field>
            <field name="appears_on_payslip">True</field>
        </record>


    <!-- ════════════════════════════════════════════════════════════════════
         ESTRUCTURA: BONIFICACIÓN ART. 223 CT
         - INFOTEP empleado 0.5% sobre este monto
         - El excedente del tope (45 o 60 días) no está exento de ISR
    ═══════════════════════════════════════════════════════════════════════ -->

        <record id="rule_bono_monto" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_bono"/>
            <field name="name">Bonificación (participación en beneficios)</field>
            <field name="code">BONO</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# El monto se carga como input BONO_MONTO (calculado por Martín/Angélica desde utilidades)
result = inputs.BONO_MONTO.amount if inputs.BONO_MONTO else 0.0
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="rule_bono_infotep_emp" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_bono"/>
            <field name="name">INFOTEP empleado (0.5% sobre bonificación)</field>
            <field name="code">INFOTEP_EMP</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = categories.GROSS * payslip._rule_parameter('rd_infotep_emp')
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="rule_bono_isr" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_bono"/>
            <field name="name">ISR — Retención sobre bonificación</field>
            <field name="code">ISR_BONO</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = categories.GROSS > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# La bonificación es gravable ISR. Usar tasa marginal del empleado.
# Simplificación: usar tasa del último tramo activo del empleado.
# TODO: integrar con el recibo de nómina del mes para tasa exacta.
base_anual = categories.GROSS * 12
exencion = payslip._rule_parameter('rd_isr_exencion')
t2_techo = payslip._rule_parameter('rd_isr_t2_techo')
t3_techo = payslip._rule_parameter('rd_isr_t3_techo')
t3_base  = payslip._rule_parameter('rd_isr_t3_base')
t4_base  = payslip._rule_parameter('rd_isr_t4_base')
if base_anual <= exencion:
    result = 0.0
elif base_anual <= t2_techo:
    result = (base_anual - exencion) * 0.15 / 12
elif base_anual <= t3_techo:
    result = (t3_base + (base_anual - t2_techo) * 0.20) / 12
else:
    result = (t4_base + (base_anual - t3_techo) * 0.25) / 12
            </field>
            <field name="appears_on_payslip">True</field>
        </record>

        <record id="rule_bono_net" model="hr.salary.rule">
            <field name="struct_id" ref="struct_ag_bono"/>
            <field name="name">Neto bonificación</field>
            <field name="code">NET</field>
            <field name="sequence">200</field>
            <field name="category_id" ref="hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.GROSS + categories.DED</field>
            <field name="appears_on_payslip">True</field>
        </record>

    </data>
</odoo>
