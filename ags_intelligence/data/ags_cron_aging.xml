<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_ags_aging" model="ir.cron">
        <field name="name">AG Intelligence: congelar antiguedad de saldos</field>
        <field name="model_id" ref="model_ags_aging"/>
        <field name="state">code</field>
        <field name="code">model.cron_generar_cortes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="False"/>
    </record>

    <!--
        Se instala desactivado. Antes de encenderlo conviene generar los
        cortes historicos a mano para tener serie con que comparar: un solo
        punto no muestra tendencia.
    -->

</odoo>
