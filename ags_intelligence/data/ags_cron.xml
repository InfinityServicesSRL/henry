<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_ags_calcular_mediciones" model="ir.cron">
        <field name="name">AG Intelligence: calcular mediciones</field>
        <field name="model_id" ref="model_ags_medicion"/>
        <field name="state">code</field>
        <field name="code">model.cron_calcular_mediciones()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="doall" eval="False"/>
    </record>

    <!--
        Se instala DESACTIVADO a proposito.

        Antes de encenderlo hay que congelar el baseline. Si el cron empieza a
        generar mediciones sin baseline de referencia, las comparaciones salen
        vacias y se acumula ruido en la serie.

        Secuencia recomendada:
          1. Instalar el modulo
          2. Revisar y ajustar el catalogo de parametros
          3. Calcular y congelar el baseline (marcando calidad del dato)
          4. Recien entonces activar este cron
    -->

</odoo>
