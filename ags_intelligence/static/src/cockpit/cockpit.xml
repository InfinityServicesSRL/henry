<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ags_intelligence.Cockpit">
    <div class="o_ags_cockpit h-100 overflow-auto">

        <!-- Encabezado -->
        <div class="o_ags_barra d-flex align-items-center justify-content-between px-4 py-3">
            <div class="d-flex align-items-center gap-3">
                <h4 class="mb-0 fw-bold">Cockpit de Gerencia</h4>
                <span class="o_ags_periodo" t-if="state.datos">
                    <t t-esc="state.datos.periodo"/>
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm" t-on-click="() => state.mostrarFiltros = !state.mostrarFiltros"
                        t-att-class="hayFiltro ? 'btn-primary' : 'btn-light'"
                        title="Filtros">
                    <i class="fa fa-filter"/>
                    <span t-if="hayFiltro" class="ms-1" t-esc="Object.keys(state.filtros).length"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.mover(1)"
                        title="Mes anterior">
                    <i class="fa fa-chevron-left"/>
                </button>
                <button class="btn btn-sm btn-light" t-on-click="() => this.mover(-1)"
                        t-att-disabled="state.mes === 0" title="Mes siguiente">
                    <i class="fa fa-chevron-right"/>
                </button>
                <button class="btn btn-sm btn-primary" t-on-click="recalcular"
                        t-att-disabled="state.recalculando">
                    <i class="fa fa-refresh me-1" t-att-class="{ 'fa-spin': state.recalculando }"/>
                    Recalcular
                </button>
            </div>
        </div>

        <!-- Barra de filtros -->
        <div t-if="state.mostrarFiltros" class="o_ags_filtros px-4 py-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="o_ags_filtro_label">Vendedor</label>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.cambiarFiltro('vendedor_id', ev.target.value)">
                        <option value="">Todos</option>
                        <option t-foreach="state.opciones.vendedores" t-as="v" t-key="v.id"
                                t-att-value="v.id"
                                t-att-selected="state.filtros.vendedor_id === v.id"
                                t-esc="v.nombre"/>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="o_ags_filtro_label">Mercado</label>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.cambiarFiltro('mercado_id', ev.target.value)">
                        <option value="">Todos</option>
                        <option t-foreach="state.opciones.mercados" t-as="m" t-key="m.id"
                                t-att-value="m.id"
                                t-att-selected="state.filtros.mercado_id === m.id"
                                t-esc="m.nombre"/>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="o_ags_filtro_label">Almacen</label>
                    <select class="form-select form-select-sm"
                            t-on-change="(ev) => this.cambiarFiltro('almacen_id', ev.target.value)">
                        <option value="">Todos</option>
                        <option t-foreach="state.opciones.almacenes" t-as="a" t-key="a.id"
                                t-att-value="a.id"
                                t-att-selected="state.filtros.almacen_id === a.id"
                                t-esc="a.nombre"/>
                    </select>
                </div>
            </div>
            <div class="o_ags_detalle mt-2">
                El filtro alcanza a ventas, metas, rentabilidad por cliente y — con almacen —
                a la banda de confianza. Los indicadores agregados no se pueden filtrar y
                quedan marcados como tales.
            </div>
        </div>

        <!-- Cargando -->
        <div t-if="state.cargando" class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando</span>
            </div>
        </div>

        <div t-else="" class="p-4">

            <!-- Filtros activos -->
            <div t-if="state.datos.hay_filtro" class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <span class="o_ags_titulo_zona">Filtrando por</span>
                <span t-foreach="state.datos.filtros_activos" t-as="f" t-key="f.clave"
                      class="o_ags_chip" t-on-click="() => this.quitarFiltro(f.clave)">
                    <t t-esc="f.campo"/>: <strong t-esc="f.valor"/>
                    <i class="fa fa-times ms-2"/>
                </span>
                <button class="btn btn-sm btn-link p-0" t-on-click="limpiarFiltros">Limpiar</button>
            </div>

            <!-- ZONA 0 · BANDA DE CONFIANZA
                 Va antes que cualquier cifra. Si el ERP tiene pendientes que
                 distorsionan los numeros, el gerente se entera antes de leer
                 el primero, no despues de tomar una decision con el. -->
            <div t-if="confianza" class="o_ags_banda mb-4"
                 t-att-class="claseBanda(confianza.nivel)">
                <div class="d-flex align-items-start gap-3 px-3 py-2">
                    <i class="fa mt-1" t-att-class="iconoBanda(confianza.nivel)"/>
                    <div class="flex-grow-1">
                        <div class="o_ags_banda_titular" t-esc="confianza.titular"/>
                        <div t-if="confianza.nivel !== 'ok'" class="o_ags_detalle mt-1">
                            Las cifras de este periodo se calcularon con estos pendientes abiertos.
                        </div>
                    </div>
                    <button t-if="confianza.nivel !== 'ok'" class="btn btn-sm btn-link p-0 flex-shrink-0"
                            t-on-click="() => state.mostrarBanda = !state.mostrarBanda">
                        <t t-if="state.mostrarBanda">Ocultar detalle</t>
                        <t t-else="">Ver detalle</t>
                    </button>
                </div>

                <div t-if="state.mostrarBanda and confianza.nivel !== 'ok'"
                     class="o_ags_banda_detalle px-3 pb-3">
                    <div class="row g-2">
                        <div t-foreach="hallazgosSucios" t-as="h" t-key="h.clave"
                             class="col-12 col-sm-6 col-lg-4">
                            <div class="o_ags_hallazgo d-flex align-items-center gap-2 px-2 py-2"
                                 t-att-class="'o_ags_' + h.gravedad"
                                 t-on-click="() => this.abrirHallazgo(h)">
                                <span class="o_ags_hallazgo_cifra" t-esc="h.cantidad"/>
                                <span class="flex-grow-1">
                                    <t t-esc="h.etiqueta"/>
                                    <span t-if="h.es_global and state.filtros.almacen_id"
                                          class="o_ags_sello ms-1">toda la empresa</span>
                                </span>
                                <i class="fa fa-angle-right o_ags_flecha"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ZONA 1 · EXCEPCIONES -->
            <div class="o_ags_excepciones mb-4">
                <div t-if="!state.datos.excepciones.length"
                     class="o_ags_todo_bien d-flex align-items-center gap-2 px-3 py-2">
                    <i class="fa fa-check-circle"/>
                    <span>Sin excepciones este periodo. Todos los indicadores dentro de rango.</span>
                </div>

                <div t-else="">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="o_ags_titulo_zona">Requiere atencion</span>
                            <span class="badge text-bg-danger" t-esc="state.datos.n_excepciones"/>
                        </div>
                        <button class="btn btn-sm btn-link p-0"
                                t-on-click="() => state.mostrarExcepciones = !state.mostrarExcepciones">
                            <t t-if="state.mostrarExcepciones">Ocultar</t>
                            <t t-else="">Mostrar</t>
                        </button>
                    </div>

                    <div t-if="state.mostrarExcepciones" class="d-flex flex-column gap-1">
                        <div t-foreach="state.datos.excepciones" t-as="e" t-key="e_index"
                             class="o_ags_excepcion d-flex align-items-start gap-3 px-3 py-2"
                             t-att-class="'o_ags_' + e.gravedad"
                             t-on-click="() => this.abrir(e)">
                            <span class="o_ags_marca"/>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" t-esc="e.titulo"/>
                                <div class="o_ags_detalle" t-esc="e.detalle"/>
                            </div>
                            <i class="fa fa-angle-right o_ags_flecha"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ZONA 2 · VENTAS DEL MES -->
            <div class="o_ags_tarjeta mb-4 p-3">
                <div class="d-flex align-items-baseline justify-content-between mb-3">
                    <span class="o_ags_titulo_zona">Ventas del mes</span>
                    <div class="text-end">
                        <span class="o_ags_cifra_grande" t-esc="state.datos.ventas.real"/>
                        <span t-if="state.datos.ventas.hay_meta" class="o_ags_detalle ms-2">
                            de <t t-esc="state.datos.ventas.meta"/>
                            · <t t-esc="state.datos.ventas.cumplimiento"/>%
                        </span>
                    </div>
                </div>
                <div t-if="!state.datos.ventas.hay_meta" class="o_ags_detalle mb-2">
                    Sin metas aprobadas para este periodo.
                </div>
                <table class="table table-sm mb-0 o_ags_tabla">
                    <tbody>
                        <tr t-foreach="state.datos.ventas.por_vendedor" t-as="v" t-key="v_index">
                            <td t-esc="v.nombre"/>
                            <td class="text-end" t-esc="v.real"/>
                            <td class="text-end o_ags_detalle" t-esc="v.meta"/>
                            <td class="text-end" style="width: 90px">
                                <span t-if="v.meta_num" class="badge"
                                      t-att-class="v.cumplimiento >= 100 ? 'text-bg-success' : (v.cumplimiento >= 80 ? 'text-bg-warning' : 'text-bg-danger')">
                                    <t t-esc="v.cumplimiento"/>%
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- ZONA 3 · BLOQUE EJECUTIVO
                 Sale de mediciones agregadas de empresa. Cuando hay un filtro
                 activo se sella para que nadie lea estas cifras como si
                 pertenecieran al vendedor o mercado elegido. -->
            <div t-foreach="porEje" t-as="g" t-key="g.eje" class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="o_ags_titulo_zona" t-esc="g.nombre"/>
                    <span t-if="state.datos.hay_filtro" class="o_ags_sello">
                        <i class="fa fa-globe me-1"/>Toda la empresa
                    </span>
                </div>
                <div class="row g-3">
                    <div t-foreach="g.tarjetas" t-as="t" t-key="t.codigo"
                         class="col-12 col-sm-6 col-lg-3">
                        <div class="o_ags_kpi h-100 p-3" t-on-click="() => this.abrirParametro(t)">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <span class="o_ags_kpi_etiqueta" t-esc="t.etiqueta"/>
                                <span class="badge" t-att-class="claseSemaforo(t.semaforo)"
                                      t-if="t.semaforo !== 'sin_dato'">
                                    <t t-if="t.semaforo === 'verde'">En rango</t>
                                    <t t-elif="t.semaforo === 'amarillo'">Atencion</t>
                                    <t t-else="">Fuera</t>
                                </span>
                            </div>
                            <div class="o_ags_kpi_valor" t-att-class="{ 'o_ags_sin_dato': !t.hay_dato }"
                                 t-esc="t.valor"/>

                            <!-- Delta contra el mes anterior y contra el mismo mes
                                 del año pasado. Nunca contra el año completo: ocho
                                 meses no se comparan con doce. -->
                            <div t-if="t.hay_dato" class="o_ags_deltas mt-2">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="o_ags_detalle" t-att-class="claseTendencia(t.delta_mes.sentido)">
                                        <i class="fa" t-att-class="iconoTendencia(t.delta_mes.sentido)"/>
                                        <t t-if="t.delta_mes.hay_dato">
                                            <t t-esc="Math.abs(t.delta_mes.pct)"/>%
                                        </t>
                                        <t t-else="">sin previo</t>
                                    </span>
                                    <span class="o_ags_detalle">vs mes anterior</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="o_ags_detalle"
                                          t-att-class="claseTendencia(t.delta_homologo.sentido)">
                                        <t t-if="t.delta_homologo.hay_dato">
                                            <i class="fa" t-att-class="iconoTendencia(t.delta_homologo.sentido)"/>
                                            <t t-esc="Math.abs(t.delta_homologo.pct)"/>%
                                        </t>
                                        <t t-else="">sin comparable</t>
                                    </span>
                                    <span class="o_ags_detalle">
                                        vs <t t-esc="state.datos.homologo_label"/>
                                    </span>
                                </div>
                            </div>

                            <!-- Referencias: de donde arranco y a donde debe llegar -->
                            <div t-if="t.baseline or t.objetivo" class="o_ags_kpi_refs mt-2">
                                <span t-if="t.baseline">base <t t-esc="t.baseline"/></span>
                                <span t-if="t.baseline and t.objetivo"> · </span>
                                <span t-if="t.objetivo">meta <t t-esc="t.objetivo"/></span>
                            </div>

                            <div t-if="t.atipico" class="o_ags_aviso mt-2">
                                <i class="fa fa-exclamation-triangle me-1"/>Periodo atipico
                            </div>
                            <div t-elif="t.madurez === 'con_reservas'" class="o_ags_aviso mt-2">
                                <i class="fa fa-info-circle me-1"/>Dato con reservas
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</t>

</templates>
