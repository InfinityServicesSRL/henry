<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu raiz de la aplicacion.
         web_icon agregado en Fase 2A: sin el, el menu raiz no siempre se
         renderiza en la cuadricula de aplicaciones de Odoo 18. -->
    <menuitem id="menu_ags_root"
            name="Inteligencia"
            sequence="90"
            web_icon="ags_intelligence,static/description/icon.png"
            groups="ags_intelligence.group_ags_delegado"/>

    <!-- Pantalla de inicio -->
    <menuitem id="menu_ags_cockpit"
            name="Cockpit"
            parent="menu_ags_root"
            action="action_ags_cockpit"
            sequence="1"/>

    <menuitem id="menu_ags_inicio"
            name="Inicio"
            parent="menu_ags_root"
            action="action_ags_welcome"
            sequence="2"/>

    <!-- ============================================================
         SISTEMA DE PARAMETROS (Fase 2A)
         El tablero de control del sistema: aqui se define que se mide,
         contra que se compara y como evoluciona.
         ============================================================ -->

    <menuitem id="menu_ags_parametros_root"
            name="Parametros"
            parent="menu_ags_root"
            sequence="10"/>

    <menuitem id="menu_ags_parametro"
            name="Catalogo de parametros"
            parent="menu_ags_parametros_root"
            action="action_ags_parametro"
            sequence="10"/>

    <menuitem id="menu_ags_medicion"
            name="Mediciones"
            parent="menu_ags_parametros_root"
            action="action_ags_medicion"
            sequence="20"/>

    <menuitem id="menu_ags_baseline"
            name="Baselines congelados"
            parent="menu_ags_parametros_root"
            action="action_ags_baseline"
            sequence="30"/>

    <menuitem id="menu_ags_benchmark"
            name="Benchmarks de mercado"
            parent="menu_ags_parametros_root"
            action="action_ags_benchmark"
            sequence="40"/>

    <menuitem id="menu_ags_proyeccion"
            name="Proyecciones"
            parent="menu_ags_parametros_root"
            action="action_ags_proyeccion"
            sequence="50"
            groups="ags_intelligence.group_ags_manager"/>

    <!-- ============================================================
         CONFIGURACION
         ============================================================ -->

    <!-- Antiguedad de saldos -->
    <menuitem id="menu_ags_alerta"
            name="Alertas"
            parent="menu_ags_root"
            action="action_ags_alerta"
            sequence="5"/>

    <menuitem id="menu_ags_metas_root"
            name="Metas"
            parent="menu_ags_root"
            sequence="15"/>

    <menuitem id="menu_ags_meta"
            name="Metas de gestion"
            parent="menu_ags_metas_root"
            action="action_ags_meta"
            sequence="10"/>

    <menuitem id="menu_ags_mercado"
            name="Mercados"
            parent="menu_ags_metas_root"
            action="action_ags_mercado"
            sequence="20"/>

    <menuitem id="menu_ags_rentabilidad"
            name="Rentabilidad por cliente"
            parent="menu_ags_metas_root"
            action="action_ags_rentabilidad"
            sequence="15"
            groups="ags_intelligence.group_ags_manager"/>

    <menuitem id="menu_ags_cartera"
            name="Cartera"
            parent="menu_ags_root"
            sequence="20"
            groups="ags_intelligence.group_ags_manager"/>

    <menuitem id="menu_ags_aging_cxc"
            name="Antiguedad por cobrar"
            parent="menu_ags_cartera"
            action="action_ags_aging_cxc"
            sequence="10"/>

    <menuitem id="menu_ags_aging_cxp"
            name="Antiguedad por pagar"
            parent="menu_ags_cartera"
            action="action_ags_aging_cxp"
            sequence="20"/>

    <menuitem id="menu_ags_abastecimiento"
            name="Abastecimiento"
            parent="menu_ags_root"
            sequence="25"
            groups="ags_intelligence.group_ags_manager"/>

    <menuitem id="menu_ags_importaciones"
            name="Importaciones pendientes"
            parent="menu_ags_abastecimiento"
            action="action_ags_importaciones_pendientes"
            sequence="10"/>

    <menuitem id="menu_ags_sustitutas"
            name="Compras sustitutas"
            parent="menu_ags_abastecimiento"
            action="action_ags_compras_sustitutas"
            sequence="20"/>

    <menuitem id="menu_ags_config"
            name="Configuracion"
            parent="menu_ags_root"
            sequence="99"
            groups="ags_intelligence.group_ags_manager"/>

    <menuitem id="menu_ags_config_contable"
            name="Configuracion contable"
            parent="menu_ags_config"
            action="action_ags_config"
            sequence="5"/>

    <menuitem id="menu_ags_estacionalidad"
            name="Factores de estacionalidad"
            parent="menu_ags_config"
            action="action_ags_estacionalidad"
            sequence="10"/>

    <menuitem id="menu_ags_regimen"
            name="Regimenes de datos"
            parent="menu_ags_config"
            action="action_ags_regimen"
            sequence="15"/>

    <menuitem id="menu_ags_fuente"
            name="Fuentes de investigacion"
            parent="menu_ags_config"
            action="action_ags_fuente"
            sequence="20"/>

    <!--
        Estructura prevista para fases siguientes:
          - Cockpit de Gerencia      (Fase 2A, cierre)
          - Costos y Rentabilidad    (Fase 2B)
          - Financiero y Caja        (Fase 2C)
          - Demanda y Ventas         (Fase 2D)
          - Inventario y Materiales  (Fase 2D)
          - Inteligencia Comercial   (Fase 2E)
    -->

</odoo>
