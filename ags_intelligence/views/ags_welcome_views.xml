<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ags_welcome_form" model="ir.ui.view">
        <field name="name">ags.welcome.form</field>
        <field name="model">ags.welcome</field>
        <field name="arch" type="xml">
            <form string="AG Intelligence">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="nota" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ags_welcome_list" model="ir.ui.view">
        <field name="name">ags.welcome.list</field>
        <field name="model">ags.welcome</field>
        <field name="arch" type="xml">
            <list string="AG Intelligence">
                <field name="name"/>
                <field name="nota"/>
            </list>
        </field>
    </record>

    <record id="action_ags_welcome" model="ir.actions.act_window">
        <field name="name">AG Intelligence</field>
        <field name="res_model">ags.welcome</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Modulo AG Intelligence instalado</p>
            <p>Los tableros se construyen en las fases siguientes.</p>
        </field>
    </record>

</odoo>
