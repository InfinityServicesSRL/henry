<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ags" model="ir.module.category">
        <field name="name">AG Intelligence</field>
        <field name="description">Acceso al modulo de inteligencia y analitica.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_ags_manager" model="res.groups">
        <field name="name">Gerencia / Contabilidad</field>
        <field name="category_id" ref="module_category_ags"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Acceso completo a AG Intelligence. Informacion sensible restringida a Gerencia y Contabilidad.</field>
    </record>

    <!-- Auto-asignacion al administrador durante la instalacion.
         Sin esto, en cada instalacion limpia nadie ve el menu hasta que
         alguien asigna el grupo manualmente, y el modulo parece no haberse
         instalado. Se detecto en las pruebas de la Fase 1. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('ags_intelligence.group_ags_manager'))]"/>
    </record>

    <!--
        NOTA DE DISENO PENDIENTE (Fase 2B):
        Hoy existe un solo grupo con acceso total. Cuando el modulo maneje
        margenes por cliente, P&L y costos unitarios, conviene evaluar una
        separacion entre:
          - quien consulta tableros comerciales (vendedores)
          - quien ve informacion financiera sensible (Gerencia, Contabilidad)
        Con un solo grupo la decision es binaria: o entran a todo o a nada.
    -->

</odoo>
