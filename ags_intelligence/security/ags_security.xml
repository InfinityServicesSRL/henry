<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ags" model="ir.module.category">
        <field name="name">AG Intelligence</field>
        <field name="description">Acceso al modulo de inteligencia y analitica.</field>
        <field name="sequence">20</field>
    </record>

    <!--
        DOS NIVELES DE ACCESO.

        Delegado: opera con el cockpit y responde por sus indicadores, pero no
        ve margenes por cliente, cuentas por pagar, P&L ni costos unitarios.

        Gerencia: ve todo. Implica al delegado, asi que basta un grupo por
        persona en lugar de dos casillas que alguien puede dejar a medias.

        Que es sensible NO se decide aqui: se decide en el campo
        ags.parametro.confidencial. Este archivo solo declara quien puede ver
        lo marcado, no que esta marcado.
    -->

    <record id="group_ags_delegado" model="res.groups">
        <field name="name">Delegado</field>
        <field name="category_id" ref="module_category_ags"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Cockpit y seguimiento de indicadores, sin informacion financiera sensible.</field>
    </record>

    <record id="group_ags_manager" model="res.groups">
        <field name="name">Gerencia / Contabilidad</field>
        <field name="category_id" ref="module_category_ags"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('ags_intelligence.group_ags_delegado'))]"/>
        <field name="comment">Acceso completo a AG Intelligence, incluida la informacion sensible.</field>
    </record>

    <!-- Auto-asignacion al administrador durante la instalacion.
         Sin esto, en cada instalacion limpia nadie ve el menu hasta que
         alguien asigna el grupo manualmente, y el modulo parece no haberse
         instalado. Se detecto en las pruebas de la Fase 1. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('ags_intelligence.group_ags_manager'))]"/>
    </record>

    <!-- ============================================================
         REGLAS DE REGISTRO

         Odoo une con OR las reglas de grupos distintos. Como Gerencia implica
         Delegado, hace falta una regla permisiva explicita para Gerencia:
         sin ella, la regla restrictiva del delegado tambien la alcanzaria.
         ============================================================ -->

    <record id="rule_ags_parametro_delegado" model="ir.rule">
        <field name="name">Parametros: el delegado no ve los confidenciales</field>
        <field name="model_id" ref="model_ags_parametro"/>
        <field name="domain_force">[('confidencial', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_ags_delegado'))]"/>
    </record>

    <record id="rule_ags_parametro_gerencia" model="ir.rule">
        <field name="name">Parametros: Gerencia ve todo</field>
        <field name="model_id" ref="model_ags_parametro"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ags_manager'))]"/>
    </record>

    <record id="rule_ags_medicion_delegado" model="ir.rule">
        <field name="name">Mediciones: el delegado no ve las confidenciales</field>
        <field name="model_id" ref="model_ags_medicion"/>
        <field name="domain_force">[('confidencial', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_ags_delegado'))]"/>
    </record>

    <record id="rule_ags_medicion_gerencia" model="ir.rule">
        <field name="name">Mediciones: Gerencia ve todo</field>
        <field name="model_id" ref="model_ags_medicion"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ags_manager'))]"/>
    </record>

    <record id="rule_ags_meta_delegado" model="ir.rule">
        <field name="name">Metas: el delegado ve las suyas</field>
        <field name="model_id" ref="model_ags_meta"/>
        <field name="domain_force">[('vendedor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ags_delegado'))]"/>
    </record>

    <record id="rule_ags_meta_gerencia" model="ir.rule">
        <field name="name">Metas: Gerencia ve todas</field>
        <field name="model_id" ref="model_ags_meta"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ags_manager'))]"/>
    </record>

    <!-- Las alertas de clientes exponen quien destruye valor y cuanto: es
         justamente el dato que la separacion de grupos protege. -->
    <record id="rule_ags_alerta_delegado" model="ir.rule">
        <field name="name">Alertas: sin clientes ni parametros confidenciales</field>
        <field name="model_id" ref="model_ags_alerta"/>
        <field name="domain_force">['&amp;', ('tipo', '!=', 'cliente'), '|', ('parametro_id', '=', False), ('parametro_id.confidencial', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_ags_delegado'))]"/>
    </record>

    <record id="rule_ags_alerta_gerencia" model="ir.rule">
        <field name="name">Alertas: Gerencia ve todas</field>
        <field name="model_id" ref="model_ags_alerta"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ags_manager'))]"/>
    </record>

</odoo>
